# .env.example — Variables de entorno del proyecto SIMP Monitor
#
# Copia este archivo a .env y ajusta los valores:
#   cp deploy/.env.example .env
#
# NUNCA subas el archivo .env al repositorio (está en .gitignore)

# ── Servidor SIMP (C++) ───────────────────────────────────────
SIMP_SERVER_PORT=9000          # puerto TCP del protocolo SIMP
HTTP_SERVER_PORT=9001          # puerto del servidor HTTP (interfaz web)

# ── Auth Service (Python Flask) ───────────────────────────────
AUTH_BIND_HOST=0.0.0.0         # interfaz de escucha del auth service
AUTH_BIND_PORT=9002            # puerto del auth service

# ── DNS — nombre del servidor (configurado en Route 53) ───────
# El código resuelve estos hostnames via DNS, nunca IPs directas.
SIMP_SERVER_HOST=monitor.iot-monitor.local   # hostname para clientes Python
AUTH_SERVICE_HOST=auth.iot-monitor.local     # hostname que usa el servidor C++

# ── Tokens de autenticación de los sensores ───────────────────
# Deben coincidir con los valores en auth_service/users.json
TOKEN_TEMP=tok_temp_001
TOKEN_HUM=tok_hum_001
TOKEN_PRES=tok_pres_001
TOKEN_VIB=tok_vib_001
TOKEN_ENER=tok_ener_001

# ── Token del operador ────────────────────────────────────────
OPERATOR_ID=operator_01
OPERATOR_TOKEN=tok_op_001

# ── Logs ──────────────────────────────────────────────────────
IOT_LOG_DIR=/opt/iot-monitor/logs   # directorio de logs en EC2
